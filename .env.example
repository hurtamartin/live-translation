# Copy to .env and fill in. Never commit the real .env.

# Gemini API key (Google AI Studio). Can also be entered in /admin instead.
GEMINI_API_KEY=

# Password for /admin. If empty, one is generated and printed in the container log.
ADMIN_PASSWORD=

# Host port for plain HTTP.
HTTP_PORT=8080

# Only for `docker compose --profile https`: public domain pointing to this server.
DOMAIN=

# Optional
# LOG_LEVEL=INFO
# MAX_CLIENTS=1000
# X-Forwarded-* headers are only believed from these proxy addresses (Caddy in
# docker-compose is covered by the default). TRUST_PROXY=0 ignores them completely.
# TRUSTED_PROXIES=127.0.0.0/8,::1/128,172.16.0.0/12
# TRUST_PROXY=1
# TZ=Europe/Prague
